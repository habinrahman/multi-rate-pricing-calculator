{
  "name": "@multi-rate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests --pool=threads --poolOptions.threads.singleThread"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@multi-rate/shared": "file:../../packages/shared",
    "argon2": "0.45.1",
    "fastify": "^5.2.0",
    "mongodb": "^6.12.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.2.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
