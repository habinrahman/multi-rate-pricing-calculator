# syntax=docker/dockerfile:1
FROM node:22-alpine AS builder

WORKDIR /app

# Install native dependencies for argon2 compilation
RUN apk add --no-cache python3 make g++

# Copy package manifests
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/api/package*.json ./apps/api/
COPY apps/web/package*.json ./apps/web/

# Install all dependencies
RUN npm ci

# Copy source files
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Build shared and api packages
RUN npm --workspace @multi-rate/shared run build
RUN npm --workspace @multi-rate/api run build

# Production Runner Stage
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Copy root and package manifests for runtime module resolution
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/api/package*.json ./apps/api/

# Copy compiled artifacts and node_modules from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Use non-root user for security
USER node

EXPOSE 4000

CMD ["node", "apps/api/dist/server.js"]
