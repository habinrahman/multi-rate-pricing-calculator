# Multi-Rate Pricing Calculator Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL

# ==========================================
# API Service Configuration (apps/api/.env)
# ==========================================
NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=multi_rate_pricing
WEB_ORIGIN=https://multi-rate.example.com,http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-key-at-least-32-chars-long
LOG_LEVEL=info

# ==========================================
# Frontend Configuration (apps/web/.env.local)
# ==========================================
NEXT_PUBLIC_API_URL=https://api.multi-rate.example.com/api
